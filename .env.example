# 伪装主题:python / claude / codex / vim / ide / logtail(留空用默认 python)
# python  = 伪 Python 源码(小说藏在 docstring 绿色,外面是彩色代码骨架)
# claude  = Claude Code 会话(tool call + 输出块 + diff)
# codex   = OpenAI Codex CLI(Working spinner + turn 计数)
# vim     = 伪 Vim 编辑器(行号 gutter + ~ 空行 + INSERT)
# ide     = 伪 IDE(文件树 + md 预览 + 终端面板)
# logtail = 伪生产日志(结构化 msg + 活动行)
CLI_NOVEL_DISGUISE=python

# 数据目录(默认 ~/.cli-novel-reader)
# CLI_NOVEL_DATA=/path/to/data

# 进度同步间隔(秒)
CLI_NOVEL_SYNC_INTERVAL=30